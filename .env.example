NODE_ENV=development
PORT=3000
# Leave blank on most deployment platforms so Node binds to all interfaces.
HOST=
APP_NAME=Fitness Buddy
APP_URL=http://localhost:3000

# Generate a production secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-characters
SESSION_TTL_MS=604800000

# Comma-separated list for production, for example:
# ALLOWED_ORIGINS=https://fitness-buddy.example.com,https://www.fitness-buddy.example.com
ALLOWED_ORIGINS=http://localhost:3000

DB_PATH=./data/db.sqlite

# Optional. Without this key, the app still runs and the browser coach falls back to offline tips.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-1.2b-instruct:free
